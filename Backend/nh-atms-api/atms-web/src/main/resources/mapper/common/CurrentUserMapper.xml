<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 현재 사용자(고정 개인번호) — TB_INSA · TB_SCR_AUTH · TB_OFC_REG_MGT (설계 §5.3, API 계약 §1) -->
<mapper namespace="kr.co.nh.atms.web.common.auth.CurrentUserMapper">

    <!--
      TB_INSA.PER_NO VARCHAR2(9)
      [임시] 개발 DB 에 TB_INSA 가 아직 없어서 DUAL 인라인 뷰(가상 1행)로 대신한다.
        - 설정한 개인번호(atms.fixed-user.per-no)가 그대로 PER_NO 로 돌아오므로 "인사정보 없음(ME_001)" 이 나지 않는다.
        - NAME 은 화면 확인용 임시 값, SAMUSO·SAMUSO_NAME 은 NULL (사무소·권한은 TB_SCR_AUTH 에서 온다).
      TB_INSA 가 생기면 아래 FROM 괄호 블록을 지우고 원래 SQL 로 되돌린다:
        SELECT PER_NO, NAME, SAMUSO, SAMUSO_NAME FROM TB_INSA WHERE PER_NO = #{perNo}
    -->
    <select id="selectInsa" resultType="kr.co.nh.atms.web.common.auth.InsaRow">
        SELECT PER_NO,
               NAME,
               SAMUSO,
               SAMUSO_NAME
          FROM (SELECT CAST(#{perNo} AS VARCHAR2(9))   AS PER_NO,
                       CAST('임시사용자' AS VARCHAR2(10)) AS NAME,
                       CAST(NULL AS VARCHAR2(6))       AS SAMUSO,
                       CAST(NULL AS VARCHAR2(36))      AS SAMUSO_NAME
                  FROM DUAL) TB_INSA
         WHERE PER_NO = #{perNo}
    </select>

    <!-- TB_SCR_AUTH: DEPT_CODE·OFC_CODE CHAR(6), APV_STS CHAR(2), DUE_DATE CHAR(14) → RTRIM. 채택 규칙은 CurrentUserLoader.pickAuth(잠정) -->
    <select id="selectAuths" resultType="kr.co.nh.atms.web.common.auth.ScrAuthRow">
        SELECT RTRIM(DEPT_CODE) AS DEPT_CODE,
               RTRIM(OFC_CODE)  AS OFC_CODE,
               AUTH,
               RTRIM(APV_STS)   AS APV_STS,
               RTRIM(DUE_DATE)  AS DUE_DATE
          FROM TB_SCR_AUTH
         WHERE PER_NO = #{perNo}
    </select>

    <!-- TB_OFC_REG_MGT.OFC_CODE CHAR(6) ← 바인드 값은 CAST (21지침 §5) -->
    <select id="selectKanm" resultType="string">
        SELECT KANM
          FROM TB_OFC_REG_MGT
         WHERE OFC_CODE = CAST(#{ofcCode} AS CHAR(6))
    </select>

</mapper>
