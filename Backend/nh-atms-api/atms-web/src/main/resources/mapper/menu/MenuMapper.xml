<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 내 메뉴 — TB_SCR_MENU ⟕ TB_SCR_AUTH_MENU (설계 §5.4·§5.5). 트리 구성·가지치기는 MenuService.buildTree -->
<mapper namespace="kr.co.nh.atms.web.menu.mapper.MenuMapper">

    <!--
      [임시] 개발 DB 에 TB_SCR_AUTH_MENU 가 아직 없어서 조인을 빼고 권한 5개를 'Y' 로 고정한다.
        - TB_SCR_MENU 의 사용 중(USE_YN='Y') 메뉴가 모두 보인다. 고정 사용자는 지금 관리자('A')라
          MenuService.buildTree 가 어차피 모두 'Y' 로 덮어쓰므로 결과는 같다.
      TB_SCR_AUTH_MENU 가 생기면 원래 SQL 로 되돌린다(권한 5개 줄과 FROM 아래 조인):
               NVL(AM.QRY_ROL_YN, 'N') AS QRY_ROL_YN,   (REG·UPD·DEL·EXE 도 같은 모양)
          FROM TB_SCR_MENU M
          LEFT JOIN TB_SCR_AUTH_MENU AM
                 ON AM.MENU_ID = M.MENU_ID
                AND AM.AUTH = #{auth}
                AND AM.USE_YN = 'Y'
    -->
    <select id="selectMenusWithAuth" resultType="kr.co.nh.atms.web.menu.dto.MenuNode">
        SELECT M.MENU_ID,
               M.PARENT_MENU_ID,
               M.MENU_NM,
               M.MENU_TYPE,
               M.MENU_PATH,
               M.SORT_NO,
               M.USE_YN,
               'Y' AS QRY_ROL_YN,
               'Y' AS REG_ROL_YN,
               'Y' AS UPD_ROL_YN,
               'Y' AS DEL_ROL_YN,
               'Y' AS EXE_ROL_YN
          FROM TB_SCR_MENU M
         WHERE M.USE_YN = 'Y'
         ORDER BY M.SORT_NO, M.MENU_ID
    </select>

</mapper>
