# npm run dev — 실제 백엔드에 붙는 개발 서버(http://localhost:3100). 백엔드 없이 보려면 npm run dev:mock
# 내 PC 에서만 바꿀 값은 .env.development.local 에 적는다(Git 제외).
VITE_USE_MOCK=false
VITE_API_BASE=/api
VITE_ENV_LABEL=local
# 메뉴 출처: auto(기본 — /api/menu/my 응답에 화면이 없으면 내장 메뉴 시드) | api | static
VITE_MENU_SOURCE=auto
# 개발 서버 프록시 대상(브라우저 번들에는 들어가지 않음)
#  - 내 PC 에서 백엔드 실행: http://localhost:8080
#  - 폐쇄망 개발 서버(WebtoB 경유): http://<WebtoB 주소>:9000
DEV_PROXY_TARGET=http://localhost:8080
